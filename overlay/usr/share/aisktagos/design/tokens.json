  "font": {
    "ui": "SF Pro Display, Inter, system-ui, sans-serif",
    "mono": "SF Mono, JetBrains Mono, monospace",
    "size": {
      "caption": 8,
      "small": 9.5,
      "body": 11,
      "lead": 13,
      "h3": 16,
      "h2": 22,
      "h1": 34,
      "display": 56
