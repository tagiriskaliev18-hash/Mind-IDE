    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "tracking": {
      "tight": -0.5,
      "normal": 0,
      "wide": 0.5,
      "wider": 1.0
    }
  },
  "transition": "all 0.18s cubic-bezier(0.25, 0.46, 0.45, 0.94)",
  "rule": "Единый стиль Mind: никаких эмодзи, только иконки Mind; переливающийся фиолетово-синий градиент; 3D-вставки (слои теней, блик, наклон); bounce-анимации при наведении, нажатии и появлении.",
  "gradient": {
    "stops": [
      "#a46cf0",
      "#7c66df",
      "#5b8dee",
      "#49b3f7"
    ],
    "angle": 120,
    "mind": "linear-gradient(120deg, #a46cf0 0%, #7c66df 35%, #5b8dee 70%, #49b3f7 100%)",
    "flow": "linear-gradient(120deg, #a46cf0 0%, #7c66df 22%, #5b8dee 45%, #49b3f7 58%, #5b8dee 72%, #8b63e8 88%, #a46cf0 100%)",
    "soft": "linear-gradient(120deg, rgba(155,93,229,0.18), rgba(91,141,238,0.14), rgba(0,245,255,0.12))"
  },
  "motion": {
    "shimmer": "6s",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "bounceIn": "0.55s",
    "press": "0.12s",
    "hoverLift": -2,
    "hoverScale": 1.04,
    "pressScale": 0.94
  },
  "depth": {
    "highlight": "inset 0 1px 0 rgba(255,255,255,0.35), inset 0 -2px 6px rgba(20,10,60,0.35)",
    "raised": "0 1px 0 rgba(255,255,255,0.08) inset, 0 2px 4px rgba(10,5,30,0.35), 0 8px 18px rgba(91,77,207,0.28), 0 18px 36px rgba(0,0,0,0.25)",
    "glow": "0 0 0 1px rgba(155,93,229,0.35), 0 6px 22px rgba(91,141,238,0.45)",
    "tilt": 6,
    "perspective": 800
  }
}
